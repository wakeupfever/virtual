{
  "name": "virtual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "提示词 → 可交互原型 → 正式页面：三层分层前端工作区",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --open /packages/design-system/showcase.html",
    "dev:prototype": "vite --open /apps/prototypes/_template.html",
    "build:ds": "pnpm --filter @virtual/design-system build",
    "check:prototype": "node scripts/check-prototype.js",
    "check:layer2": "pnpm --filter @virtual/design-system check:layer2",
    "lint": "eslint",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @virtual/web dev",
    "build:web": "pnpm --filter @virtual/web build",
    "prepare": "husky || true",
    "test:visual": "node tests/visual/compare.mjs",
    "test:mutation": "node tests/visual/mutate.mjs",
    "check:ledger": "node scripts/check-ledger.mjs"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "pixelmatch": "^7.2.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "apps/web/src/**/*.{ts,vue}": "eslint --max-warnings=0",
    "packages/design-system/ui/**/*.{ts,vue}": "eslint --max-warnings=0",
    "packages/design-system/{tokens.css,layout.css,base.css,skins/*.css,ui/**/*.vue}": "node packages/design-system/scripts/check-layer2.mjs",
    "apps/prototypes/*.html": "node scripts/check-prototype.js",
    "doc/*.rai.md": "node scripts/check-ledger.mjs"
  }
}
