{
  "name": "@virtual/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "第一层 token/布局 + 第二层复合组件，原型与正式项目共用",
  "type": "module",
  "main": "./ui/index.ts",
  "exports": {
    ".": "./ui/index.ts",
    "./tokens.css": "./tokens.css",
    "./layout.css": "./layout.css",
    "./base.css": "./base.css",
    "./whitelist.json": "./whitelist.json"
  },
  "scripts": {
    "dev": "vite --open /showcase.html",
    "build": "vite build --config vite.lib.config.ts && node scripts/build-tokens.mjs && node scripts/check-layer2.mjs",
    "check:layer2": "node scripts/check-layer2.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:tokens": "node scripts/build-tokens.mjs"
  },
  "peerDependencies": {
    "element-plus": "^2.14.5",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "element-plus": "^2.14.5",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.2.0"
  }
}
